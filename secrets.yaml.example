# Copy to secrets.yaml (not committed) and fill in real values.
# API key: 32 random bytes, base64 (e.g. `openssl rand -base64 32`).

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Ground floor (P0)
p0_ap_password: "fallback-ap-password"
p0_api_key: "base64-api-encryption-key"
p0_ota_password: "ota-password"

# First floor (P1)
p1_ap_password: "fallback-ap-password"
p1_api_key: "base64-api-encryption-key"
p1_ota_password: "ota-password"
